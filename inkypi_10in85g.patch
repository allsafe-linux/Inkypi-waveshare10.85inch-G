diff --git a/src/plugins/meeting/render/meeting.css b/src/plugins/meeting/render/meeting.css
new file mode 100644
index 0000000..5e83335
--- /dev/null
+++ b/src/plugins/meeting/render/meeting.css
@@ -0,0 +1,247 @@
+/*
+ * Meeting 插件 —— 微雪 10.85" 四色 e-Paper (G) 版式
+ *
+ * 墨水屏只有 4 色（黑 / 白 / 黄 / 红），所以：
+ *   - 不使用 box-shadow（浅灰阴影会被抖成一圈噪点）
+ *   - 分隔线用 2px solid currentColor（1px 在量化时容易糊掉）
+ *   - 色块一律直角（圆角边缘的抗锯齿会在 4 色量化下糊成毛边）
+ *   - 所有前景色只取面板四色之一
+ */
+
+.meeting-board {
+  display: flex;
+  flex-direction: column;
+  width: 100%;
+  height: 100%;
+  box-sizing: border-box;
+  overflow: hidden;
+}
+
+/* ============================ 门牌视图 ============================ */
+
+.room-head {
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+  flex: 0 0 auto;
+  border-bottom: 2px solid currentColor;
+  padding-bottom: 0.35em;
+}
+
+/* 头尾两行的子项不参与压缩，否则长文本会把它们挤扁 */
+.room-head > *,
+.room-next > * {
+  flex-shrink: 0;
+}
+
+.room-name {
+  font-size: calc(min(7dvh, 7dvw) * 1.15);
+  font-weight: 700;
+  line-height: 1.1;
+}
+
+.room-clock {
+  display: flex;
+  align-items: baseline;
+  gap: 0.6em;
+}
+
+.room-time {
+  font-size: calc(min(6dvh, 6dvw) * 1.15);
+  font-weight: 600;
+}
+
+.room-date {
+  font-size: calc(min(4.2dvh, 4.2dvw));
+}
+
+.room-body {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  justify-content: center;
+  gap: 0.25em;
+  padding: 0.3em 0;
+}
+
+.status-badge {
+  display: inline-block;
+  align-self: flex-start;
+  padding: 0.12em 0.7em;
+  font-size: calc(min(5dvh, 5dvw));
+  font-weight: 700;
+  letter-spacing: 0.12em;
+  line-height: 1.25;
+}
+
+.room-title {
+  font-size: calc(min(15dvh, 15dvw));
+  font-weight: 700;
+  line-height: 1.15;
+  overflow: hidden;
+  /* ★ 这里原本用 display:-webkit-box + -webkit-line-clamp:2 做两行截断，
+   *   在 flex column 容器里 -webkit-box 会被 blockify，line-clamp 算出的
+   *   行高是错的，导致 .room-body 高度偏小、内容溢出，
+   *   最后被 .meeting-board 的 overflow:hidden 整块裁掉（整屏只剩边框）。
+   *   改成普通块 + max-height 限制两行，行为可预期。 */
+  max-height: 2.3em;
+}
+
+.room-title-idle {
+  color: inherit;
+}
+
+.room-meta {
+  display: flex;
+  align-items: baseline;
+  gap: 1em;
+  flex-wrap: wrap;
+}
+
+.room-time-range {
+  font-size: calc(min(6.5dvh, 6.5dvw));
+  font-weight: 600;
+}
+
+.room-remaining {
+  font-size: calc(min(5dvh, 5dvw));
+}
+
+.room-location {
+  font-size: calc(min(5.2dvh, 5.2dvw));
+}
+
+.room-next {
+  flex: 0 0 auto;
+  border-top: 2px solid currentColor;
+  padding-top: 0.3em;
+  display: flex;
+  align-items: baseline;
+  gap: 0.9em;
+  overflow: hidden;
+}
+
+.next-label {
+  font-size: calc(min(4.2dvh, 4.2dvw));
+  font-weight: 700;
+  letter-spacing: 0.1em;
+  flex: 0 0 auto;
+}
+
+.next-time {
+  font-size: calc(min(5.2dvh, 5.2dvw));
+  font-weight: 600;
+  flex: 0 0 auto;
+}
+
+.next-title {
+  font-size: calc(min(5.2dvh, 5.2dvw));
+  flex: 1 1 auto;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.next-location {
+  font-size: calc(min(4.2dvh, 4.2dvw));
+  flex: 0 0 auto;
+}
+
+.next-empty {
+  opacity: 1;
+}
+
+/* ============================ 议程视图 ============================ */
+
+.agenda-head {
+  flex: 0 0 auto;
+  display: flex;
+  align-items: baseline;
+  gap: 0.8em;
+  border-bottom: 2px solid currentColor;
+  padding-bottom: 0.3em;
+}
+
+.agenda-heading {
+  font-size: calc(min(6dvh, 6dvw));
+  font-weight: 700;
+}
+
+.agenda-range {
+  font-size: calc(min(4.4dvh, 4.4dvw));
+}
+
+.agenda-list {
+  flex: 1;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  overflow: hidden;
+}
+
+.agenda-row {
+  /* ★ 这里必须用 % 或 vw，不能用 cqw：
+   *   cqw 需要「容器查询上下文」(container-type: size)，而本插件没有设，
+   *   声明会被整条丢弃 -> grid 退回默认单列 -> 行高暴涨 ->
+   *   内容被 .agenda-list 的 overflow:hidden 裁掉，只剩分隔线。 */
+  display: grid;
+  grid-template-columns: 22% 1fr 20%;
+  align-items: baseline;
+  gap: 0.6em;
+  padding: 0.35em 0;
+  border-top: 2px solid currentColor;
+  overflow: hidden;
+}
+
+.agenda-row:first-child {
+  border-top: none;
+}
+
+.agenda-time {
+  font-size: calc(min(4.8dvh, 4.8dvw));
+  font-weight: 600;
+  white-space: nowrap;
+}
+
+.agenda-title {
+  font-size: calc(min(5.6dvh, 5.6dvw));
+  font-weight: 600;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.agenda-location {
+  font-size: calc(min(4.2dvh, 4.2dvw));
+  text-align: right;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.agenda-live {
+  display: inline-block;
+  margin-left: 0.6em;
+  padding: 0.05em 0.5em;
+  font-size: calc(min(3.4dvh, 3.4dvw));
+  font-weight: 700;
+  border: 2px solid currentColor;
+  letter-spacing: 0.08em;
+}
+
+.agenda-more {
+  flex: 0 0 auto;
+  padding-top: 0.25em;
+  font-size: calc(min(4dvh, 4dvw));
+  text-align: center;
+  border-top: 2px solid currentColor;
+}
+
+.agenda-empty {
+  flex: 1;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  font-size: calc(min(6dvh, 6dvw));
+}
diff --git a/src/plugins/meeting/render/meeting.html b/src/plugins/meeting/render/meeting.html
new file mode 100644
index 0000000..6219b0d
--- /dev/null
+++ b/src/plugins/meeting/render/meeting.html
@@ -0,0 +1,93 @@
+{% extends "plugin.html" %}
+
+{% block content %}
+<style>
+    {% for f in extra_fonts %}
+    @font-face { font-family: "{{ f.family }}"; src: url("{{ f.url }}") format("truetype"); }
+    {% endfor %}
+</style>
+
+<div class="meeting-board"
+     style="background-color: {{ bg_color_hex }};
+            color: {{ text_color_hex }};
+            {% if font_family %}font-family: '{{ font_family }}', sans-serif;{% endif %}">
+
+{% if view == 'room' %}
+    {# ================= 门牌视图 ================= #}
+    <div class="room-head">
+        <div class="room-name">{{ room_name if room_name else '会议室' }}</div>
+        <div class="room-clock">
+            <span class="room-time">{{ now_text }}</span>
+            <span class="room-date">{{ now_date_text }}</span>
+        </div>
+    </div>
+
+    <div class="room-body">
+        <div class="status-badge" style="background-color: {{ status_bg_hex }}; color: {{ status_text_hex }};">
+            {{ status_text }}
+        </div>
+
+        {% if current_event %}
+            <div class="room-title">{{ current_event.title }}</div>
+            <div class="room-meta">
+                <span class="room-time-range">{{ current_time_text }}</span>
+                {% if remaining_text %}<span class="room-remaining">{{ remaining_text }}</span>{% endif %}
+            </div>
+            {% if current_location %}
+                <div class="room-location">{{ current_location }}</div>
+            {% endif %}
+        {% else %}
+            <div class="room-title room-title-idle">{{ now_text }}</div>
+            <div class="room-meta"><span class="room-time-range">暂无进行中的会议</span></div>
+        {% endif %}
+    </div>
+
+    <div class="room-next">
+        {% if next_event %}
+            <span class="next-label">下一个</span>
+            <span class="next-time">{{ next_time_text }}</span>
+            <span class="next-title">{{ next_title }}</span>
+            {% if next_location %}<span class="next-location">{{ next_location }}</span>{% endif %}
+        {% else %}
+            <span class="next-label">下一个</span>
+            <span class="next-title next-empty">暂无后续会议</span>
+        {% endif %}
+    </div>
+
+{% else %}
+    {# ================= 议程视图 ================= #}
+    <div class="agenda-head">
+        <span class="agenda-heading">议程</span>
+        <span class="agenda-range">{{ agenda_range_text }}</span>
+    </div>
+
+    {% if agenda_rows %}
+    <div class="agenda-list">
+        {% for row in agenda_rows %}
+        <div class="agenda-row{% if row.is_running %} is-running{% endif %}">
+            <div class="agenda-time"{% if row.is_running %} style="color: {{ accent_hex }};"{% endif %}>{{ row.time_text }}</div>
+            <div class="agenda-title">
+                {{ row.title }}
+                {% if row.is_running %}<span class="agenda-live" style="background-color: {{ accent_hex }}; color: {{ accent_text_hex }};">进行中</span>{% endif %}
+            </div>
+            <div class="agenda-location">{{ row.location }}</div>
+        </div>
+        {% endfor %}
+    </div>
+    {% if agenda_hidden %}
+    <div class="agenda-more">还有 {{ agenda_hidden }} 条…</div>
+    {% endif %}
+    {% else %}
+    <div class="agenda-empty">
+        {% if fetch_error %}
+            没有取到会议数据
+        {% else %}
+            这段时间没有会议
+        {% endif %}
+    </div>
+    {% endif %}
+{% endif %}
+
+</div>
+
+{% endblock %}
diff --git a/src/plugins/meeting/settings.html b/src/plugins/meeting/settings.html
new file mode 100644
index 0000000..a3dac38
--- /dev/null
+++ b/src/plugins/meeting/settings.html
@@ -0,0 +1,208 @@
+<div>
+  <label class="form-label">视图：</label>
+  <div class="button-group" id="viewSelector">
+    {% for code, label in view_options %}
+    <button type="button" data-value="{{ code }}" onclick="selectView(this)">{{ label }}</button>
+    {% endfor %}
+  </div>
+  <input type="hidden" name="viewMode" id="viewMode" value="room">
+</div>
+
+<div class="form-group">
+  <label class="form-label">日历订阅（ICS）：</label>
+  <div id="calendarList"></div>
+  <button type="button" id="addCalendarBtn" class="form-input collapsible" onclick="addCalendarInput('')">添加日历</button>
+</div>
+
+<div class="form-group">
+  <label for="roomName" class="form-label">房间名称：</label>
+  <input type="text" id="roomName" name="roomName" class="form-input" placeholder="e.g. 三号会议室">
+</div>
+
+<div class="form-group" data-visible-modes="agenda">
+  <div class="form-group nowrap">
+    <label for="daysAhead" class="form-label">提前天数：</label>
+    <input type="number" id="daysAhead" name="daysAhead" class="form-input" min="1" max="14" value="1">
+  </div>
+  <div class="form-group nowrap">
+    <label for="maxEvents" class="form-label">最多显示几条：</label>
+    <input type="number" id="maxEvents" name="maxEvents" class="form-input" min="1" max="30" value="6">
+  </div>
+</div>
+
+<div class="form-group">
+  <label for="showLocation" class="form-label">显示地点：</label>
+  <div class="toggle-container">
+    <input type="hidden" id="showLocationValue" name="showLocation" value="true">
+    <input type="checkbox" id="showLocation" class="toggle-checkbox" checked>
+    <label for="showLocation" class="toggle-label"></label>
+  </div>
+</div>
+
+<div class="form-group">
+  <label for="fontKey" class="form-label">字体：</label>
+  <select id="fontKey" name="fontKey" class="form-input">
+    {% for code, label in font_options %}
+    <option value="{{ code }}">{{ label }}</option>
+    {% endfor %}
+  </select>
+</div>
+
+<div class="form-group">
+  <label for="bgColor" class="form-label">背景：</label>
+  <select id="bgColor" name="bgColor" class="form-input">
+    {% for code, hex in color_options %}
+    <option value="{{ code }}">{{ code }}</option>
+    {% endfor %}
+  </select>
+</div>
+
+<div class="form-group">
+  <label for="textColor" class="form-label">文字颜色：</label>
+  <select id="textColor" name="textColor" class="form-input">
+    {% for code, hex in color_options %}
+    <option value="{{ code }}">{{ code }}</option>
+    {% endfor %}
+  </select>
+</div>
+
+<div class="form-group">
+  <button type="button" id="clearMemoryBtn" class="form-input collapsible">清除已保存的设置</button>
+</div>
+
+<script>
+    const STORAGE_KEY = 'inkypi.meeting.draft.v1';
+    let saveTimer = null;
+
+    function selectView(button) {
+      document.querySelectorAll('#viewSelector button').forEach(btn => btn.classList.remove('active'));
+      button.classList.add('active');
+      document.getElementById('viewMode').value = button.getAttribute('data-value');
+      updateViewDependentOptions(document.getElementById('viewMode').value);
+      scheduleSave();
+    }
+
+    function updateViewDependentOptions(viewMode) {
+      document.querySelectorAll('[data-visible-modes]').forEach(el => {
+        const allowed = el.getAttribute('data-visible-modes').split(',');
+        const show = allowed.includes(viewMode);
+        el.style.display = show ? '' : 'none';
+        el.querySelectorAll('input, select, textarea').forEach(input => {
+          input.disabled = !show;
+        });
+      });
+    }
+
+    function addCalendarInput(url = '') {
+      const list = document.getElementById('calendarList');
+      const wrapper = document.createElement('div');
+      wrapper.classList.add('calendar-entry');
+      wrapper.classList.add('form-group');
+
+      const urlInput = document.createElement('input');
+      urlInput.type = 'text';
+      urlInput.name = 'calendarURLs[]';
+      urlInput.placeholder = 'ICS / webcal URL';
+      urlInput.classList.add('form-input');
+      urlInput.value = url;
+
+      const removeBtn = document.createElement('button');
+      removeBtn.type = 'button';
+      removeBtn.innerText = '✕';
+      removeBtn.classList.add('remove-btn');
+      removeBtn.onclick = () => { wrapper.remove(); scheduleSave(); };
+
+      wrapper.appendChild(urlInput);
+      wrapper.appendChild(removeBtn);
+      list.appendChild(wrapper);
+    }
+
+    function collectDraft() {
+      return {
+        viewMode: document.getElementById('viewMode').value,
+        roomName: document.getElementById('roomName').value,
+        daysAhead: document.getElementById('daysAhead').value,
+        maxEvents: document.getElementById('maxEvents').value,
+        showLocation: document.getElementById('showLocationValue').value,
+        fontKey: document.getElementById('fontKey').value,
+        bgColor: document.getElementById('bgColor').value,
+        textColor: document.getElementById('textColor').value,
+        calendarURLs: Array.from(document.querySelectorAll('input[name="calendarURLs[]"]')).map(i => i.value)
+      };
+    }
+
+    function scheduleSave() {
+      clearTimeout(saveTimer);
+      saveTimer = setTimeout(() => {
+        try { localStorage.setItem(STORAGE_KEY, JSON.stringify(collectDraft())); } catch (e) { /* ignore */ }
+      }, 250);
+    }
+
+    function applyDraft(draft) {
+      if (!draft) return;
+      document.getElementById('viewMode').value = draft.viewMode || 'room';
+      document.querySelectorAll('#viewSelector button').forEach(btn => {
+        btn.classList.toggle('active', btn.getAttribute('data-value') === document.getElementById('viewMode').value);
+      });
+      if (draft.roomName !== undefined) document.getElementById('roomName').value = draft.roomName;
+      if (draft.daysAhead !== undefined) document.getElementById('daysAhead').value = draft.daysAhead;
+      if (draft.maxEvents !== undefined) document.getElementById('maxEvents').value = draft.maxEvents;
+      if (draft.showLocation !== undefined) {
+        document.getElementById('showLocationValue').value = draft.showLocation;
+        document.getElementById('showLocation').checked = draft.showLocation === 'true';
+      }
+      if (draft.fontKey) document.getElementById('fontKey').value = draft.fontKey;
+      if (draft.bgColor) document.getElementById('bgColor').value = draft.bgColor;
+      if (draft.textColor) document.getElementById('textColor').value = draft.textColor;
+      const list = document.getElementById('calendarList');
+      list.innerHTML = '';
+      (draft.calendarURLs || []).forEach(u => addCalendarInput(u));
+      updateViewDependentOptions(document.getElementById('viewMode').value);
+    }
+
+    document.addEventListener('DOMContentLoaded', () => {
+      // 服务器上的实例设置优先（已加入播放列表的情况）
+      if (typeof loadPluginSettings !== 'undefined' && loadPluginSettings && pluginSettings) {
+        const s = pluginSettings;
+        if (s.viewMode) document.getElementById('viewMode').value = s.viewMode;
+        if (s.roomName !== undefined) document.getElementById('roomName').value = s.roomName;
+        if (s.daysAhead !== undefined) document.getElementById('daysAhead').value = s.daysAhead;
+        if (s.maxEvents !== undefined) document.getElementById('maxEvents').value = s.maxEvents;
+        if (s.showLocation !== undefined) {
+          document.getElementById('showLocationValue').value = s.showLocation;
+          document.getElementById('showLocation').checked = s.showLocation === 'true';
+        }
+        if (s.fontKey) document.getElementById('fontKey').value = s.fontKey;
+        if (s.bgColor) document.getElementById('bgColor').value = s.bgColor;
+        if (s.textColor) document.getElementById('textColor').value = s.textColor;
+        (s['calendarURLs[]'] || []).forEach(u => addCalendarInput(u));
+      } else {
+        try { applyDraft(JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null')); } catch (e) { /* ignore */ }
+      }
+
+      // 没有任何来源时，至少给一个空的日历输入框
+      if (document.getElementById('calendarList').children.length === 0) {
+        addCalendarInput('');
+      }
+
+      document.querySelectorAll('#viewSelector button').forEach(btn => {
+        btn.classList.toggle('active', btn.getAttribute('data-value') === document.getElementById('viewMode').value);
+      });
+      updateViewDependentOptions(document.getElementById('viewMode').value);
+
+      document.getElementById('showLocation').addEventListener('change', function () {
+        document.getElementById('showLocationValue').value = this.checked ? 'true' : 'false';
+        scheduleSave();
+      });
+      document.getElementById('clearMemoryBtn').addEventListener('click', function () {
+        try { localStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
+        document.getElementById('calendarList').innerHTML = '';
+        addCalendarInput('');
+      });
+
+      document.querySelectorAll('#viewSelector button, #roomName, #daysAhead, #maxEvents, #fontKey, #bgColor, #textColor')
+        .forEach(el => el.addEventListener('change', scheduleSave));
+      document.getElementById('roomName').addEventListener('input', scheduleSave);
+      document.getElementById('calendarList').addEventListener('input', scheduleSave);
+    });
+</script>
