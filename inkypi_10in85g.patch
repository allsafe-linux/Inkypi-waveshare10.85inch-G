+        self.ReadBusyH()
+
+        #Fast
+        self.SendCommand(0xE0)
+        self.SendData(0x03);    			
+        self.SendCommand(0xE6)
+        self.SendData(92);
+        self.SendCommand(0xA5)		
+        self.SendData(0x00)
+        self.ReadBusyH() 
